# Config for the Docker Compose stack (docker-compose.yml).
# Copy to `.env` in this directory and fill in real secrets:
#     cp .env.docker.example .env
#     ./scripts/gen-secrets.sh >> .env      # generates strong random values
#
# Compose builds the DATABASE_URL / DATABASE_URL_AUTH / DATABASE_URL_MIGRATOR
# connection strings from these parts, pointing at the internal `db` host — you
# do NOT set the full URLs here.

# ============ Postgres ============
POSTGRES_DB=falaq_dashboard
# Use strong, unique values (see scripts/gen-secrets.sh).
OWNER_DB_PASSWORD=change-me-owner
APP_DB_PASSWORD=change-me-app
AUTH_DB_PASSWORD=change-me-auth

# ============ Better Auth ============
# openssl rand -base64 32
BETTER_AUTH_SECRET=generate-a-32-byte-secret
# The public URL users hit. For real deployments use your https:// domain.
BETTER_AUTH_URL=http://localhost:3000
TRUSTED_ORIGINS=

# ============ Runtime ============
DB_POOL_MAX=10

# ============ Meta Marketing API (optional; blank = fixtures) ============
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_AD_ACCOUNT_IDS=
META_BUSINESS_ID=
META_API_VERSION=v23.0
