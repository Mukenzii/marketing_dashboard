# ============ Postgres ============
POSTGRES_DB=falaq_dashboard
OWNER_DB_PASSWORD=change-me-owner
APP_DB_PASSWORD=change-me-app
AUTH_DB_PASSWORD=change-me-auth

# App runtime connection — restricted role, RLS-enforced (lib/db).
DATABASE_URL=postgres://falaq_app:change-me-app@localhost:5433/falaq_dashboard

# Auth connection — BYPASSRLS, granted only the auth tables (Better Auth).
DATABASE_URL_AUTH=postgres://falaq_auth:change-me-auth@localhost:5433/falaq_dashboard

# Migrations / DDL connection — owner role (drizzle-kit only).
DATABASE_URL_MIGRATOR=postgres://falaq_owner:change-me-owner@localhost:5433/falaq_dashboard

# ============ Better Auth ============
# openssl rand -base64 32
BETTER_AUTH_SECRET=generate-a-32-byte-secret
# Public base URL of the app. In production this MUST be your real https:// URL
# (drives secure cookies + CSRF trusted origin).
BETTER_AUTH_URL=http://localhost:3000
# Extra comma-separated origins allowed to drive auth (CSRF). Optional.
TRUSTED_ORIGINS=

# ============ Runtime / performance ============
# production | development — production enables secure cookies + strict CSP.
NODE_ENV=development
# Max Postgres connections for the app pool (per instance) and the auth pool.
DB_POOL_MAX=10
DB_AUTH_POOL_MAX=4
# How long (ms) a user's role/status row is cached before re-reading the DB.
# Lower = fresher privileges, higher = fewer queries. Admin changes bypass it.
USER_CACHE_TTL_MS=20000

# ============ Meta (Facebook) Marketing API ============
# Fill these to switch the dashboard from fixtures to live Meta Ads data.
# Server-only — never exposed to the browser. Leave blank to keep using fixtures.
#
# App ID + secret: developers.facebook.com → your App → Settings → Basic
META_APP_ID=
META_APP_SECRET=
# System User token (Business Settings → Users → System Users → Generate token),
# scope: ads_read. Long-lived; no refresh needed.
META_ACCESS_TOKEN=
# Ad accounts to pull, comma-separated, each prefixed with act_
# e.g. act_1234567890,act_9876543210
META_AD_ACCOUNT_IDS=
# Optional — Business Manager id, to auto-discover all accounts under it.
META_BUSINESS_ID=
# Graph API version to pin. Leave blank to use the app default.
META_API_VERSION=v23.0